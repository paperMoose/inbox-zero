# Gmail Configuration
GMAIL_USER=you@gmail.com

# VIP List (comma-separated email addresses)
VIP_EMAILS=important@example.com,boss@company.com

# Protected Senders - These will NEVER be filtered or archived
# Add healthcare, travel, financial services here
PROTECTED_SENDERS=doctor@hospital.org,alerts@bank.com

# Protected Keywords - Emails with these words won't be auto-filtered
PROTECTED_KEYWORDS=appointment,flight,boarding,medical,doctor,prescription,emergency